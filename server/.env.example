# ==============================
# Database
# ==============================
# На Railway: копіюй з вкладки Variables → DATABASE_URL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# ==============================
# Authentication
# ==============================
# Генерація: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your-strong-random-64-char-secret-here"

# ==============================
# Google OAuth
# ==============================
# Створи на: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID="xxxxxxxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxxxxxxxxxxx"
# На продакшені: https://your-railway-domain.up.railway.app/auth/google/callback
GOOGLE_CALLBACK_URL="https://YOUR_BACKEND_DOMAIN/auth/google/callback"

# ==============================
# URLs
# ==============================
# URL твого Vercel фронтенду
FRONTEND_URL="https://YOUR_VERCEL_APP.vercel.app"
PORT=3000

# ==============================
# Google Gemini AI
# ==============================
# Створи на: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="AIzaSy-xxxxxxxxxxxxxxxxxxxx"

# ==============================
# C++ Code Execution (Godbolt)
# ==============================
GODBOLT_API_URL="https://godbolt.org/api/compiler/g122/compile"

# ==============================
# Email (Resend — resend.com)
# ==============================
# Створи на: https://resend.com → API Keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Для тестів без верифікації домену: onboarding@resend.dev
# Для прода: noreply@yourdomain.com (потрібна верифікація домену)
MAIL_FROM="onboarding@resend.dev"


